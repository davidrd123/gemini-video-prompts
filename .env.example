# Copy without overwriting an existing .env. Uncomment only the services used
# and replace each placeholder locally. Never commit or print real keys.
# GEMINI_API_KEY=replace_with_your_gemini_api_key
# REPLICATE_API_TOKEN=replace_with_your_replicate_token
# Optional: direct OpenAI image generation (separate API billing).
# Key presence is not spending authorization. Ask the user before passing
# allow_api_billing=true (MCP) or --allow-api-billing (CLI).
# OPENAI_API_KEY=replace_with_your_openai_api_key
# Choose models in the tool call/batch or with --model. CLI environment model
# overrides must be exported before job resolution; do not rely on .env for them.
